# Modelo das variáveis de ambiente. Este arquivo VAI para o git — não ponha
# valor real em nenhuma linha aqui.
#
# Em produção, defina tudo no painel da Vercel (Settings → Environment
# Variables), marcando Production E Preview.
# Para rodar local:  vercel env pull .env.development.local

# --- A ÚNICA OBRIGATÓRIA ---

# Assina o cookie de sessão. Mínimo 32 caracteres, aleatória.
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar esta chave desloga todo mundo.
AUTH_SECRET=


# --- A URL DO BANCO ---
# Já vem pronta da integração do Neon (DATABASE_URL) ou do Vercel Postgres
# (POSTGRES_URL). O código aceita as duas, então normalmente não há nada a
# fazer aqui. Só preencha para rodar local sem a CLI da Vercel.
DATABASE_URL=


# --- OPCIONAIS ---
# Só são usados pelo `npm run migrate`. Se você criar a conta do barbeiro
# pela tela "Criar conta" do site e promover com
#   update users set role = 'admin' where lower(email) = '...';
# pode ignorar as quatro linhas abaixo.
ADMIN_EMAIL=
# Gere com `npm run hash` e cole AQUI o hash, nunca a senha.
ADMIN_PASSWORD_HASH=
ADMIN_NAME=
ADMIN_PHONE=
